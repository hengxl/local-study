<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hxl.deploy.mapper.SystemUserMapper">

    <select id="queryUserByName" resultType="com.hxl.deploy.domain.entity.User">
        select *
        from t_system_user
        where username = #{username}
    </select>

    <select id="queryAll" resultType="com.hxl.deploy.domain.entity.User">
        select *
        from t_system_user
    </select>

</mapper>